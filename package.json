    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/noto-serif-tc": "^0.4.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "tsc --noEmit && expo lint && jest",
    "i18n:convert": "node scripts/convert-strings.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "<rootDir>/src/designsystem/testing/jest.setup.ts"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
