{
  "expo": {
    "name": "Ortus Destiny",
    "slug": "ortus-destiny",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ortusdestiny.astrology.astra"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0820",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ortusdestiny.astrology.astra"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-audio",
      "expo-font",
      "expo-splash-screen"
    ],
    "scheme": "ortusdestiny",
    "backgroundColor": "#0B0820",
    "experiments": {
      "typedRoutes": false
    }
  }
}
